<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShareX.HelpersLib\ShareX.HelpersLib.csproj" />
    <ProjectReference Include="..\ShareX.ImageEffectsLib\ShareX.ImageEffectsLib.csproj" />
    <ProjectReference Include="..\ShareX.MediaLib\ShareX.MediaLib.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ImageListView">
      <HintPath>..\Libs\ImageListView.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include='HDR\Shaders\HdrToneMap.hlsl'>
      <LogicalName>ShareX.ScreenCaptureLib.HDR.HdrToneMap.hlsl</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include='HDR\Shaders\HdrAnalyze.hlsl'>
      <LogicalName>ShareX.ScreenCaptureLib.HDR.HdrAnalyze.hlsl</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include='HDR\Shaders\HdrEncodePq.hlsl'>
      <LogicalName>ShareX.ScreenCaptureLib.HDR.HdrEncodePq.hlsl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(Platform)' == 'x64' Or ('$(RuntimeIdentifier)' == '' And '$(Platform)' == 'AnyCPU' And '$(PROCESSOR_ARCHITECTURE)' == 'AMD64')">
    <Content Include="Native\UltraHdr\win-x64\ShareX.UltraHdr.dll">
      <Link>ShareX.UltraHdr.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Native\Avif\win-x64\ShareX.Avif.dll">
      <Link>ShareX.Avif.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="('$(RuntimeIdentifier)' == 'win-arm64' Or '$(Platform)' == 'ARM64' Or ('$(RuntimeIdentifier)' == '' And '$(Platform)' == 'AnyCPU' And '$(PROCESSOR_ARCHITECTURE)' == 'ARM64')) And Exists('Native\Avif\win-arm64\ShareX.Avif.dll')">
    <Content Include="Native\Avif\win-arm64\ShareX.Avif.dll">
      <Link>ShareX.Avif.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
